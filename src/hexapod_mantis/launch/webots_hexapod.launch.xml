<launch>
  <!-- Get the package share directory -->
  <let name="package_share" value="$(find-pkg-share hexapod_mantis)" />
  <!-- Arguments for initial pose -->


  <!-- ================= Launch Webots ================= -->
  <let name="world_path" value="$(var package_share)/worlds/hexapod.wbt" />
  <let name="controllers_path" value="$(var package_share)/controllers" />

<include
  file="$(find-pkg-share webots_ros2_launch)/launch/webots.launch.py">
  <arg name="world" value="$(var world_path)"/>
</include>



  <!-- =============== robot_state_publisher =============== -->
  <!-- TODO: agregar urdf -->
