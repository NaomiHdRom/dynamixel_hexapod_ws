    <param name="use_sim_time" value="true" />
    <remap from="joint_states" to="/hardware/joint_states"/>
    <remap from="robot_description" to="/hardware/base/robot_description"/>
  </node> -->
  <!-- ========== MOVE IT config + ros2_controll ========== -->
  <node
    pkg="webots_ros2_driver"
    exec="driver"
    name="webots_driver"
    output="screen">
   <param name="robot_name" value="hexapod"/>
    
    <param name="robot_description"
          value="$(command xacro $(find-pkg-share dynamixel_hexapod_description)/urdf/dynamixel_hexapod.urdf)" />
    
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- ========== RViz custom config ========== -->
