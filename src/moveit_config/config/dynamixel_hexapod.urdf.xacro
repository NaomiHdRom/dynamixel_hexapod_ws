<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dynamixel_hexapod">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import dynamixel_hexapod urdf file -->
    <xacro:include filename="$(find dynamixel_hexapod_description)/urdf/dynamixel_hexapod.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="dynamixel_hexapod.ros2_control.xacro" />


    <xacro:dynamixel_hexapod_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
